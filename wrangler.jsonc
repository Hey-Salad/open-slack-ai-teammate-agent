{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slack-ai-teammate-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "vars": {
    "OPENAI_PROJECT": "proj_mRsQVx3NjOamxeXH6UrLowoC",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "AGENTS_ENVIRONMENT_TYPE": "openai_hosted"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_START_LIMITER",
        "class_name": "SlackAiTeammateSessionStartLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-slack-ai-teammate-session-start-limiter",
      "new_sqlite_classes": ["SlackAiTeammateSessionStartLimiter"]
    }
  ]
}
